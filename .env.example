# Copy this file to .env and fill in real values before running
# `docker compose up`. Nothing in this repo ships with real secrets or any
# one operator's personal details -- every value below is a placeholder.

# --- Branding -----------------------------------------------------------
# Shown throughout the UI and in emails. Defaults to "Pigskinz" if unset.
POOL_NAME=Pigskinz

# Public URL this deployment is reachable at (used in emails and share
# links). This repo doesn't run a reverse proxy itself -- put it behind
# whatever you already have (nginx-proxy-manager, Traefik, Caddy, etc.) and
# set this to the public URL that proxy serves. See README.md.
SITE_URL=https://pool.example.com

# Host port the app container's port 3000 is published on. Point your
# reverse proxy at http://<this-host>:APP_PORT.
APP_PORT=3000

# Which published image tag `docker compose up -d` (without --build) pulls
# from ghcr.io/drollette/pigskinz-docker -- "main" tracks the latest commit
# on main; pin to a release tag (e.g. "1.2.3") once this project starts
# cutting those, or leave as-is to always track main.
IMAGE_TAG=main

# --- Email (SendGrid) -----------------------------------------------------
SENDGRID_API_KEY=
EMAIL_FROM_ADDRESS=pool@example.com
EMAIL_FROM_NAME=Pigskinz

# --- Registration ---------------------------------------------------------
# Code a new user must enter on /register.
INVITATION_CODE=change-me

# --- Web Push notifications -------------------------------------------------
# Optional -- email notifications work regardless. Leaving both blank means
# clicking "Enable" under Push in Settings just fails (the browser rejects
# subscribing with an empty key), so set these before advertising the
# feature. Generate a real pair with `npm run vapid:generate` (a plain
# P-256 keypair, base64url-encoded -- the same format `npx web-push
# generate-vapid-keys` produces, nothing app-specific about it) and paste
# the two lines it prints here.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# --- Optional real-money buy-in (e.g. LeagueSafe) --------------------------
# Leave all three unset to hide the buy-in/payouts section of the UI and
# welcome email entirely -- most self-hosted pools aren't collecting money.
LEAGUESAFE_URL=
BUYIN_AMOUNT=
BUYIN_DEADLINE=
# Freeform sentence describing how payouts are split, shown in place of any
# specific percentages this repo doesn't assume for you.
# PAYOUT_INFO=1st place takes 60% of the pot, 2nd takes 30%, 3rd takes 10%.

# --- Backups (backup/backup.sh) --------------------------------------------
# One-time setup: authorize your cloud provider from a device with a browser
# (`rclone authorize "drive"`), then hand-write the token into
# ./secrets/rclone.conf alongside a `backup-crypt` remote (`rclone obscure
# <passphrase>` for the password field -- run via `docker compose run --rm
# --entrypoint rclone backup obscure <passphrase>`, no install needed). See
# README.md's Backups section for the full walkthrough -- `rclone config
# create`'s wizard re-triggers a browser OAuth flow even with a token
# supplied, which is why this is hand-written rather than wizard-generated.
RCLONE_REMOTE=backup-crypt:pigskinz-backups
BACKUP_RETENTION_DAYS=45
BACKUP_INTERVAL_SECONDS=86400
# Optional dead-man's-switch ping (e.g. a healthchecks.io URL) after each run.
HEALTHCHECK_URL=

ENVIRONMENT_NAME=production
